# Copy this file to .env and fill in your own values
# Never commit .env, it contains your API key

# Your YouTube Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=

# Port this server runs on
PORT=3000

# Which website is allowed to call this server, the Vue dev server here.
# More than one is allowed, separated by commas and no spaces, which is what
# you need when a preview deploy has its own address:
# ALLOWED_ORIGIN=https://moodandmore.app,https://preview.moodandmore.app
ALLOWED_ORIGIN=http://localhost:5173

# Needed to let people delete their account.
# The service role key ignores every security rule, so it must stay on the
# server. Never put it in a VITE_ variable and never commit it.
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The same public key the Vue app uses. The server needs it to check a
# password before deleting an account, by trying to log in with it.
# Supabase Dashboard -> Project Settings -> API -> anon public
SUPABASE_ANON_KEY=
